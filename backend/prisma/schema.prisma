// Database schema for the location-based multi-vendor marketplace.
// Conventions (docs/04-database-design.md): UUID keys generated by PostgreSQL,
// snake_case tables and columns, money as DECIMAL(12,2) ETB, timestamps as timestamptz.
// Checks and partial indexes that Prisma cannot express live in hand-written SQL migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  MERCHANT
  SUPER_ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("shop_status")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum FulfillmentPreference {
  DELIVERY
  PICKUP

  @@map("fulfillment_preference")
}

enum PaymentMethod {
  CHAPA
  BANK_TRANSFER

  @@map("payment_method")
}

enum ParentPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  FAILED

  @@map("parent_payment_status")
}

enum ParentFulfillmentStatus {
  PENDING_PAYMENT
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED

  @@map("parent_fulfillment_status")
}

enum MerchantPaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REJECTED

  @@map("merchant_payment_status")
}

enum MerchantFulfillmentStatus {
  AWAITING_PAYMENT
  NEW
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED

  @@map("merchant_fulfillment_status")
}

enum PaymentRecordStatus {
  PENDING
  PROCESSING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REJECTED
  EXPIRED

  @@map("payment_record_status")
}

enum PaymentProvider {
  CHAPA
  MANUAL

  @@map("payment_provider")
}

enum ReceiptReviewStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("receipt_review_status")
}

enum StockHoldState {
  HELD
  COMMITTED
  RELEASED

  @@map("stock_hold_state")
}

enum SettlementStatus {
  PENDING
  SETTLED
  WITHHELD

  @@map("settlement_status")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role               UserRole
  status             UserStatus @default(ACTIVE)
  fullName           String     @map("full_name") @db.VarChar(120)
  username           String     @unique @db.VarChar(30)
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  tokenVersion       Int        @default(0) @map("token_version")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchantProfile          MerchantProfile?     @relation("MerchantProfileUser")
  merchantProfilesCreated  MerchantProfile[]    @relation("MerchantProfileCreator")
  refreshTokens            RefreshToken[]
  ownedShops               Shop[]               @relation("ShopOwner")
  addresses                CustomerAddress[]
  cart                     Cart?
  orders                   Order[]              @relation("CustomerOrders")
  merchantOrders           MerchantOrder[]      @relation("SubOrderMerchant")
  notifications            Notification[]
  auditLogs                AuditLog[]
  productViews             ProductView[]
  shopViews                ShopView[]
  uploadedReceipts         PaymentReceipt[]     @relation("ReceiptUploader")
  reviewedReceipts         PaymentReceipt[]     @relation("ReceiptReviewer")
  verifiedPayments         Payment[]            @relation("PaymentVerifier")
  settlementsOwed          MerchantSettlement[] @relation("SettlementMerchant")
  settlementsRecorded      MerchantSettlement[] @relation("SettlementActor")

  @@index([role, status])
  @@map("users")
}

/// Merchant-only details. Kept out of `users` so customer rows carry no empty merchant columns.
model MerchantProfile {
  userId          String   @id @map("user_id") @db.Uuid
  businessName    String?  @map("business_name") @db.VarChar(160)
  contactPhone    String?  @map("contact_phone") @db.VarChar(20)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User  @relation("MerchantProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("MerchantProfileCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("merchant_profiles")
}

/// Revocable sessions. The cookie holds an opaque token; only its SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// A physical merchant location. Its single map pin lives on this row (latitude/longitude).
model Shop {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String     @map("merchant_id") @db.Uuid
  name              String     @db.VarChar(160)
  slug              String     @unique @db.VarChar(180)
  description       String     @default("") @db.VarChar(5000)
  phone             String     @db.VarChar(20)
  addressText       String     @map("address_text") @db.VarChar(300)
  latitude          Decimal    @db.Decimal(9, 6)
  longitude         Decimal    @db.Decimal(9, 6)
  status            ShopStatus @default(ACTIVE)
  deliveryFeeEtb    Decimal    @default(0) @map("delivery_fee_etb") @db.Decimal(12, 2)
  bankName          String     @map("bank_name") @db.VarChar(120)
  bankAccountName   String     @map("bank_account_name") @db.VarChar(160)
  bankAccountNumber String     @map("bank_account_number") @db.VarChar(40)
  logoPublicId      String?    @map("logo_public_id") @db.VarChar(200)
  logoUrl           String?    @map("logo_url")
  coverPublicId     String?    @map("cover_public_id") @db.VarChar(200)
  coverUrl          String?    @map("cover_url")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant       User                 @relation("ShopOwner", fields: [merchantId], references: [id], onDelete: Restrict)
  products       Product[]
  merchantOrders MerchantOrder[]
  shopViews      ShopView[]
  settlements    MerchantSettlement[]

  @@index([merchantId])
  @@index([status, latitude, longitude])
  /// Trigram index for case-insensitive name search (needs the pg_trgm extension).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "shops_name_trgm_idx")
  @@map("shops")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(80)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId        String        @map("shop_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  name          String        @db.VarChar(160)
  description   String        @db.VarChar(5000)
  price         Decimal       @db.Decimal(12, 2)
  stockQuantity Int           @map("stock_quantity")
  isAvailable   Boolean       @default(true) @map("is_available")
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  productViews ProductView[]

  @@index([shopId, status])
  @@index([categoryId])
  @@index([status, price])
  /// Trigram index for case-insensitive name search (needs the pg_trgm extension).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

/// Ordered product photos. Position 0 is the cover image shown in lists.
model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  publicId  String   @map("public_id") @db.VarChar(200)
  url       String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Cart and addresses
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// Quantity of a product in a cart. Prices are never stored here; they are read live.
model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model CustomerAddress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contactName String   @map("contact_name") @db.VarChar(120)
  addressName String   @map("address_name") @db.VarChar(120)
  houseNumber String   @map("house_number") @db.VarChar(60)
  phoneNumber String   @map("phone_number") @db.VarChar(20)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Orders: one parent order per checkout, one merchant sub-order per shop
// ---------------------------------------------------------------------------

model Order {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber           String                  @unique @map("order_number") @db.VarChar(24)
  customerId            String                  @map("customer_id") @db.Uuid
  clientRequestId       String?                 @map("client_request_id") @db.VarChar(80)
  clientRequestHash     String?                 @map("client_request_hash") @db.VarChar(64)
  fulfillmentPreference FulfillmentPreference   @map("fulfillment_preference")
  contactName           String                  @map("contact_name") @db.VarChar(120)
  addressName           String                  @map("address_name") @db.VarChar(120)
  houseNumber           String                  @map("house_number") @db.VarChar(60)
  phoneNumber           String                  @map("phone_number") @db.VarChar(20)
  customerNote          String?                 @map("customer_note") @db.VarChar(500)
  paymentMethod         PaymentMethod           @map("payment_method")
  merchandiseSubtotal   Decimal                 @map("merchandise_subtotal") @db.Decimal(12, 2)
  deliveryFeeTotal      Decimal                 @map("delivery_fee_total") @db.Decimal(12, 2)
  grandTotal            Decimal                 @map("grand_total") @db.Decimal(12, 2)
  paymentStatus         ParentPaymentStatus     @map("payment_status")
  fulfillmentStatus     ParentFulfillmentStatus @map("fulfillment_status")
  stockHoldState        StockHoldState          @map("stock_hold_state")
  stockHoldExpiresAt    DateTime?               @map("stock_hold_expires_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       User            @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  merchantOrders MerchantOrder[]
  payments       Payment[]

  @@unique([customerId, clientRequestId])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([stockHoldState, stockHoldExpiresAt])
  @@map("orders")
}

model MerchantOrder {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String                    @map("order_id") @db.Uuid
  shopId             String                    @map("shop_id") @db.Uuid
  merchantId         String                    @map("merchant_id") @db.Uuid
  shopNameSnapshot   String                    @map("shop_name_snapshot") @db.VarChar(160)
  contactName        String                    @map("contact_name") @db.VarChar(120)
  addressName        String                    @map("address_name") @db.VarChar(120)
  houseNumber        String                    @map("house_number") @db.VarChar(60)
  phoneNumber        String                    @map("phone_number") @db.VarChar(20)
  customerNote       String?                   @map("customer_note") @db.VarChar(500)
  subtotal           Decimal                   @db.Decimal(12, 2)
  deliveryFee        Decimal                   @map("delivery_fee") @db.Decimal(12, 2)
  total              Decimal                   @db.Decimal(12, 2)
  paymentStatus      MerchantPaymentStatus     @map("payment_status")
  fulfillmentStatus  MerchantFulfillmentStatus @map("fulfillment_status")
  cancellationReason String?                   @map("cancellation_reason") @db.VarChar(300)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  merchant    User                @relation("SubOrderMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  bankPayment Payment?
  settlement  MerchantSettlement?

  @@unique([orderId, shopId])
  @@index([merchantId, fulfillmentStatus, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("merchant_orders")
}

/// Immutable line copied at checkout: later product edits never change name or price here.
model OrderItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantOrderId     String   @map("merchant_order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(160)
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  merchantOrder MerchantOrder @relation(fields: [merchantOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([merchantOrderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

/// One Chapa payment per parent order attempt, or one bank-transfer payment per sub-order.
model Payment {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String              @map("order_id") @db.Uuid
  merchantOrderId   String?             @unique @map("merchant_order_id") @db.Uuid
  method            PaymentMethod
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("ETB") @db.Char(3)
  status            PaymentRecordStatus
  provider          PaymentProvider
  txRef             String?             @unique @map("tx_ref") @db.VarChar(80)
  providerReference String?             @map("provider_reference") @db.VarChar(120)
  checkoutUrl       String?             @map("checkout_url")
  payerEmail        String?             @map("payer_email") @db.VarChar(254)
  verifiedAt        DateTime?           @map("verified_at") @db.Timestamptz(3)
  verifiedByUserId  String?             @map("verified_by_user_id") @db.Uuid
  failureReason     String?             @map("failure_reason") @db.VarChar(300)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  merchantOrder MerchantOrder?   @relation(fields: [merchantOrderId], references: [id], onDelete: Restrict)
  verifiedBy    User?            @relation("PaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  receipts      PaymentReceipt[]

  @@index([orderId])
  @@index([method, status])
  @@map("payments")
}

/// Proof of a bank transfer. Files are private; `storage_key` is never a public URL.
model PaymentReceipt {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String              @map("payment_id") @db.Uuid
  uploadedByUserId String              @map("uploaded_by_user_id") @db.Uuid
  storageKey       String              @map("storage_key") @db.VarChar(300)
  mimeType         String              @map("mime_type") @db.VarChar(40)
  sizeBytes        Int                 @map("size_bytes")
  note             String?             @db.VarChar(300)
  reviewStatus     ReceiptReviewStatus @default(PENDING) @map("review_status")
  reviewedAt       DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId String?             @map("reviewed_by_user_id") @db.Uuid
  rejectionReason  String?             @map("rejection_reason") @db.VarChar(300)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  uploadedBy User    @relation("ReceiptUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("ReceiptReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt(sort: Desc)])
  @@map("payment_receipts")
}

/// Ledger row for a Chapa-collected sub-order: what the platform owes the merchant.
model MerchantSettlement {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantOrderId   String           @unique @map("merchant_order_id") @db.Uuid
  shopId            String           @map("shop_id") @db.Uuid
  merchantId        String           @map("merchant_id") @db.Uuid
  grossAmount       Decimal          @map("gross_amount") @db.Decimal(12, 2)
  platformFeeAmount Decimal          @map("platform_fee_amount") @db.Decimal(12, 2)
  netAmount         Decimal          @map("net_amount") @db.Decimal(12, 2)
  status            SettlementStatus @default(PENDING)
  settledAt         DateTime?        @map("settled_at") @db.Timestamptz(3)
  settledByUserId   String?          @map("settled_by_user_id") @db.Uuid
  referenceNote     String?          @map("reference_note") @db.VarChar(200)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchantOrder MerchantOrder @relation(fields: [merchantOrderId], references: [id], onDelete: Restrict)
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  merchant      User          @relation("SettlementMerchant", fields: [merchantId], references: [id], onDelete: Restrict)
  settledBy     User?         @relation("SettlementActor", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@index([merchantId, status])
  @@map("merchant_settlements")
}

// ---------------------------------------------------------------------------
// Analytics, notifications, audit
// ---------------------------------------------------------------------------

model ProductView {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  viewerUserId String?  @map("viewer_user_id") @db.Uuid
  visitorId    String   @map("visitor_id") @db.VarChar(64)
  viewedAt     DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  viewer  User?   @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([productId, viewedAt(sort: Desc)])
  @@map("product_views")
}

model ShopView {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  viewerUserId String?  @map("viewer_user_id") @db.Uuid
  visitorId    String   @map("visitor_id") @db.VarChar(64)
  viewedAt     DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)

  shop   Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  viewer User? @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([shopId, viewedAt(sort: Desc)])
  @@map("shop_views")
}

model Notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  type            String    @db.VarChar(60)
  title           String    @db.VarChar(140)
  body            String    @db.VarChar(500)
  data            Json      @default("{}")
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-only record of administrative and payment-verification actions.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
