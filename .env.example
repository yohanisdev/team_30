# -----------------------------------------------------------------------------
# Local development configuration. Copy to `.env` (gitignored) and fill in values.
# The backend, the Prisma CLI and the Vite dev server all read this one file.
# Production (Render / Vercel) sets these in the host's environment settings instead.
# Never commit real credentials.
# -----------------------------------------------------------------------------

# ---- Backend: runtime ------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Application database (runtime). On Supabase use the pooled connection string.
DATABASE_URL=postgresql://marketplace:CHANGE_ME@localhost:5432/marketplace_dev
# Migrations only. On Supabase use the direct/session connection. Leave unset locally.
# DIRECT_DATABASE_URL=
# Separate databases used by the automated test suites (they are wiped on every run).
TEST_DATABASE_URL=postgresql://marketplace:CHANGE_ME@localhost:5432/marketplace_test
E2E_DATABASE_URL=postgresql://marketplace:CHANGE_ME@localhost:5432/marketplace_e2e

# ---- Backend: authentication ----------------------------------------------
# Long random secret, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Exact origin of the frontend (CORS allow-list).
FRONTEND_ORIGIN=http://localhost:5173
# Secure cookies require HTTPS. Keep false for http://localhost, true in production.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (Render + Vercel rewrite = 2). false locally.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# ---- Backend: image storage -----------------------------------------------
# `local` stores files under backend/storage (development only).
# `cloudinary` is required in production because Render's disk is wiped on deploy.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=marketplace

# ---- Backend: seed ---------------------------------------------------------
# `npm run db:seed` creates this Super Admin if the username does not exist yet.
ADMIN_USERNAME=superadmin
ADMIN_FULL_NAME=Platform Administrator
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Password for the demo merchants and customer created by `npm run db:seed:demo`.
DEMO_ACCOUNT_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# ---- Backend: shopping assistant -------------------------------------------
# Server-only. Create a key in Google AI Studio and paste it here.
# Do not add a VITE_ variable for this key. The browser never receives it.
# Leave it empty to disable the assistant; the API then returns "not configured".
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
# Optional read-only database role for the assistant catalog. When unset, the catalog
# reader uses fixed queries on the application connection and still cannot accept SQL.
# DATABASE_URL_CATALOG_RO=

# ---- Backend: payments (Phase 2, not used yet) -----------------------------
# CHAPA_SECRET_KEY=
# CHAPA_CALLBACK_URL=
# CHAPA_RETURN_URL=

# ---- Frontend (Vite) -------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to browser code.
VITE_API_BASE_URL=/api/v1
# Browser key restricted by HTTP referrer to your frontend origins and to the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers. DEMO_MAP_ID works for development.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Where the Vite dev server proxies /api and /uploads (not exposed to the browser).
API_PROXY_TARGET=http://localhost:4000
